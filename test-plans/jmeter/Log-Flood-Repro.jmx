<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Log Flood Repro (jmeter.log disk-fill test)">
      <stringProp name="TestPlan.comments">Self-contained test that floods jmeter.log with INFO lines (same shape as the NTBOneHun BeanShell cookie loop) to reproduce the ephemeral-storage eviction issue and to verify the RollingFile log4j2 fix caps the file. No login / no HTTP endpoint required.</stringProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables">
        <collectionProp name="Arguments.arguments">
          <elementProp name="USERS" elementType="Argument">
            <stringProp name="Argument.name">USERS</stringProp>
            <stringProp name="Argument.value">${__P(users,4)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="RAMP_UP_TIME_IN_S" elementType="Argument">
            <stringProp name="Argument.name">RAMP_UP_TIME_IN_S</stringProp>
            <stringProp name="Argument.value">${__P(ramp_up_time_in_s,1)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="DURATION_IN_S" elementType="Argument">
            <stringProp name="Argument.name">DURATION_IN_S</stringProp>
            <stringProp name="Argument.value">${__P(duration_in_s,120)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LINES_PER_ITERATION" elementType="Argument">
            <stringProp name="Argument.name">LINES_PER_ITERATION</stringProp>
            <stringProp name="Argument.value">${__P(lines_per_iteration,1000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="LINE_PADDING" elementType="Argument">
            <stringProp name="Argument.name">LINE_PADDING</stringProp>
            <stringProp name="Argument.value">${__P(line_padding,200)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </elementProp>
    </TestPlan>
    <hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="Log Flood Workload" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${USERS}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">${RAMP_UP_TIME_IN_S}</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${DURATION_IN_S}</stringProp>
        <stringProp name="ThreadGroup.delay">0</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">-1</stringProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="Flood jmeter.log with INFO lines" enabled="true">
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script">// Reproduces the customer BeanShell cookie-logging flood shape:
// per simulated cookie -> 3x "*******" + "Before Deleting" + "After Deleted"
// (the 3:1:1 ratio observed in NTBOneHun.jmx). Groovy is used instead of
// BeanShell so it floods fast; the log4j2 File appender behaviour is identical.
int lines = Integer.parseInt(vars.get('LINES_PER_ITERATION'));
int pad = Integer.parseInt(vars.get('LINE_PADDING'));
String filler = 'X' * pad;
int tn = ctx.getThreadNum();
for (int i = 0; i &lt; lines; i++) {
    log.info('*******');
    log.info('*******');
    log.info('*******');
    log.info('Before Deleting cookie[' + i + '] thread=' + tn + ' ' + filler);
    log.info('After Deleted cookie[' + i + '] thread=' + tn + ' ' + filler);
}
SampleResult.setResponseMessage('flooded ' + (lines * 5) + ' log lines');
SampleResult.setResponseCodeOK();
SampleResult.setSuccessful(true);</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
    </hashTree>
  </hashTree>
</jmeterTestPlan>
